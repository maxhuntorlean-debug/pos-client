/* ======================================================
   SALE TOTAL
   ====================================================== */

.saleTotals #saleSum {
  font-size: 28px;
  font-weight: 900;
}

.saleTotals > div:last-child {
  font-size: 26px;
  font-weight: 800;
}

.reportTotals {
  margin-top: 20px;
  padding: 16px;
  text-align: right;
}



.reportSalesTotal {
  font-size: 30px;
  font-weight: 900;
}

.reportSalesTotal span {
  color: #009900;
}

.reportBuyTotal {
  margin-top: 4px;
  font-size: 22px;
  font-weight: 500;
  color: #aaa;
}

/* ======================================================
   CREATE PRODUCT
   ====================================================== */

.incomePage {
  padding-bottom: 24px;
}

.incomeHeader {
  margin-top: 24px;
  margin-bottom: 30px;
}

.incomeNameBlock {
  margin-bottom: 24px;
}

.incomeLabel {
  display: block;
  margin-bottom: 8px;

  font-size: 18px;
  font-weight: 500;
}

.incomeNameRow {
  display: flex;
  gap: 8px;
}

.incomeNameInput {
  flex: 1;
  min-width: 0;

  height: 60px;

  padding: 0 16px;

  box-sizing: border-box;

  border: 1px solid #bbb;
  border-radius: 12px;

  background: white;

  font-size: 22px;
}

.incomeNameInput::placeholder {
  color: #aaa;
}

.incomeMicButton {
  width: 64px;
  height: 60px;

  flex: 0 0 64px;

  border: 1px solid #bbb;
  border-radius: 12px;

  background: white;

  font-size: 25px;
}

.incomePrices {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;

  margin-bottom: 30px;
}

.incomePriceBlock {
  min-width: 0;
}

.incomePriceInput {
  width: 100%;
  height: 60px;

  box-sizing: border-box;

  padding: 0 16px;

  border: 1px solid #bbb;
  border-radius: 12px;

  background: white;

  text-align: right;

  font-size: 24px;
  font-weight: 600;

  color: #999;
}

.incomePriceInput:focus {
  color: #222;
}

.incomeCreateButton {
  width: 100%;
  min-height: 60px;

  font-size: 21px;
  font-weight: 700;
}

.logTable th:first-child,
.logTable td:first-child {
  width: 34%;
}

.logTable th:last-child,
.logTable td:last-child {
  width: 66%;
}

.logInfo,
.logEvent {
  vertical-align: top;
}

.logDate {
  font-size: 15px;
  font-weight: 500;
}

.logTime {
  margin-top: 2px;
  font-size: 15px;
}

.logUsername {
  margin-top: 7px;
  font-size: 16px;
  font-weight: 600;
}

.logEventName {
  font-size: 17px;
  font-weight: 600;
}

.logEventDetails {
  margin-top: 6px;
  font-size: 14px;
  line-height: 1.4;
  color: #777;
}
/* ======================================================
   CASH JOURNAL
   ====================================================== */

.cashPage {
  position: relative;

  min-height: 100vh;

  background: #fff;
}


/* ======================================================
   CASH TABLE
   ====================================================== */

.cashTable {
  width: 100%;

  margin-top: 20px;

  table-layout: fixed;
}


.cashTable th:nth-child(1),
.cashTable td:nth-child(1) {
  width: 34%;
}


.cashTable th:nth-child(2),
.cashTable td:nth-child(2) {
  width: 28%;
}


.cashTable th:nth-child(3),
.cashTable td:nth-child(3) {
  width: 38%;
}


.cashTable tbody tr {
  cursor: pointer;
}


.cashTable td {
  vertical-align: middle;
}


.cashTable td:last-child {
  text-align: right;
}


/* ======================================================
   EMPTY
   ====================================================== */

.cashEmpty {
  padding: 35px 10px !important;

  text-align: center !important;

  color: #999;
}


/* ======================================================
   ADD DOCUMENT
   ====================================================== */

.cashAddButton {
  position: fixed;

  right: 24px;
  bottom: 24px;

  z-index: 100;

  width: 64px;
  height: 64px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0;

  border: none;
  border-radius: 50%;

  background: #111;
  color: #fff;

  font-size: 38px;
  font-weight: 300;
  line-height: 1;

  cursor: pointer;

  box-shadow:
    0 4px 14px
    rgba(0, 0, 0, 0.22);
}


.cashAddButton:active {
  transform: scale(0.96);
}


/* ======================================================
   CASH DOCUMENT
   ====================================================== */

.cashDocumentPage {
  position: relative;

  min-height: 100vh;

  background: #fff;
}


.cashDocumentHeader {
  display: flex;
  justify-content: space-between;
  gap: 16px;

  margin-bottom: 18px;

  font-size: 18px;
  font-weight: 600;
}


.cashBalanceBlock {
  margin-bottom: 18px;

  padding: 14px 16px;

  border-radius: 10px;

  background: #f3f3f3;
}


.cashBalanceBlock > div {
  display: flex;
  justify-content: space-between;
  gap: 16px;

  font-size: 18px;
}


.cashBalanceBlock strong {
  color: #009900;
}


.cashOperationsTable {
  margin-top: 0;
}


.cashOperationsTable th:first-child,
.cashOperationsTable td:first-child {
  width: 65%;
}


.cashOperationsTable th:last-child,
.cashOperationsTable td:last-child {
  width: 35%;

  text-align: right;
}


.cashClosingBalance {
  display: flex;
  justify-content: space-between;
  align-items: center;

  margin-top: 18px;

  padding: 16px;

  border-radius: 10px;

  background: #f3f3f3;

  font-size: 21px;
  font-weight: 700;
}


.cashClosingBalance strong {
  color: #009900;

  font-size: 25px;
}


/* ======================================================
   CASH MOBILE
   ====================================================== */

@media (max-width: 520px) {

  .cashPage,
  .cashDocumentPage {
    min-height: 100vh;
  }

  .cashAddButton {
    right: 18px;
    bottom: 18px;

    width: 60px;
    height: 60px;

    font-size: 35px;
  }

  .cashDocumentHeader {
    font-size: 16px;
  }

  .cashBalanceBlock > div {
    font-size: 16px;
  }

  .cashClosingBalance {
    font-size: 18px;
  }

  .cashClosingBalance strong {
    font-size: 22px;
  }
}

/* ======================================================
   CASH ACTIONS
   ====================================================== */

.cashActionButtons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;

  margin-top: 20px;
}

.cashActionButtons[hidden] {
  display: none;
}

.cashOperationButton {
  height: 64px;

  border: 1px solid #bbb;
  border-radius: 12px;

  background: #fff;

  font-size: 36px;
  font-weight: 700;
}

.cashPlusButton {
  color: #009900;
}

.cashMinusButton {
  color: #c00000;
}


/* ======================================================
   CASH OPERATION
   ====================================================== */

.cashOperationName {
  font-weight: 600;
}

.cashOperationComment {
  margin-top: 5px;

  font-size: 14px;
  color: #777;
}

.cashPositive {
  color: #009900;
  font-weight: 700;
}

.cashNegative {
  color: #c00000;
  font-weight: 700;
}


/* ======================================================
   CASH MODAL
   ====================================================== */

.cashModal {
  position: fixed;
  inset: 0;

  z-index: 1300;

  display: none;
  align-items: center;
  justify-content: center;

  padding: 20px;

  background: rgba(0, 0, 0, 0.42);
}

.cashModal.show {
  display: flex;
}

.cashModalBox {
  width: min(100%, 420px);

  padding: 20px;

  border-radius: 18px;

  background: #fff;

  box-shadow:
    0 18px 50px
    rgba(0, 0, 0, 0.28);
}

.cashModalTitle {
  margin-bottom: 16px;

  text-align: center;

  font-size: 22px;
  font-weight: 800;
}


/* ======================================================
   TYPE BUTTONS
   ====================================================== */

.cashTypeButtons {
  display: grid;
  gap: 10px;
}

.cashTypeButton {
  width: 100%;
  min-height: 56px;

  padding: 10px 14px;

  border: 1px solid #bbb;
  border-radius: 12px;

  background: #fff;

  font-size: 19px;
  font-weight: 700;
}

.cashDeleteButton {
  color: #c00000;
}


/* ======================================================
   AMOUNT
   ====================================================== */

.cashAmountInput,
.cashCommentInput {
  width: 100%;
  height: 58px;

  padding: 0 14px;

  border: 1px solid #aaa;
  border-radius: 10px;

  background: #fff;

  font-size: 24px;
}

.cashAmountInput {
  text-align: right;
  font-weight: 700;
}

.cashCommentBlock {
  margin-top: 16px;
}

.cashCommentLabel {
  margin-bottom: 7px;

  font-size: 16px;
  font-weight: 700;
}

.cashCommentInput {
  font-size: 18px;
}


/* ======================================================
   MODAL ACTIONS
   ====================================================== */

.cashModalActions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;

  margin-top: 18px;
}

.cashModalCancel,
.cashModalOk {
  width: 100%;
  min-height: 54px;

  padding: 8px;

  border: 1px solid #bbb;
  border-radius: 12px;

  background: #fff;

  font-size: 18px;
  font-weight: 700;
}

.cashModalCancel {
  margin-top: 12px;
}

.cashModalActions .cashModalCancel {
  margin-top: 0;
}

.cashModalOk {
  color: #009900;
}

.cashDateLabel {
  margin-bottom: 7px;

  font-size: 16px;
  font-weight: 700;
}

.cashDateInput {
  width: 100%;
  height: 56px;

  box-sizing: border-box;

  padding: 0 12px;

  border: 1px solid #aaa;
  border-radius: 10px;

  background: #fff;

  font-size: 20px;
}

/* =====================================================
   CASH + CUSTOM KEYBOARD
   Клавиатура должна быть поверх модального окна
   ===================================================== */

.cashDocumentPage .keyboard {
  z-index: 10001;
}

.cashDocumentPage #keyboard {
  z-index: 10001;
}

/* =====================================================
   CASH REPORT
   ===================================================== */

.cashReportPage {
  padding-bottom: 40px;
}


/* =====================================================
   PERIOD
   ===================================================== */

.cashReportPeriod {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;

  margin: 18px 0 12px;
}

.cashReportDateField {
  display: flex;
  flex-direction: column;
  gap: 6px;

  font-size: 14px;
  font-weight: 600;
}


/* =====================================================
   CONTENT
   ===================================================== */

.cashReportContent {
  margin-top: 20px;
}


/* =====================================================
   BALANCE
   ===================================================== */

.cashReportBalance {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 18px 16px;

  font-size: 18px;
}

.cashReportBalance strong {
  white-space: nowrap;
  font-size: 20px;
}

.cashReportOpening {
  border-bottom: 2px solid rgba(0, 0, 0, 0.12);
}

.cashReportClosing {
  margin-top: 8px;

  border-top: 2px solid rgba(0, 0, 0, 0.18);

  font-size: 20px;
  font-weight: 700;
}


/* =====================================================
   GROUP
   ===================================================== */

.cashReportGroup {
  border-bottom: 1px solid rgba(0, 0, 0, 0.12);
}

.cashReportGroupHeader {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 16px;

  border: 0;

  background: transparent;

  font: inherit;
  font-size: 17px;

  text-align: left;

  cursor: pointer;
}

.cashReportGroupHeader strong {
  white-space: nowrap;
}

.cashReportGroupLeft {
  display: flex;
  align-items: center;
  gap: 10px;

  min-width: 0;
}

.cashReportArrow {
  width: 18px;
  flex: 0 0 18px;

  font-size: 12px;
}


/* =====================================================
   DETAILS
   ===================================================== */

.cashReportGroupDetails {
  padding: 0 16px 12px 44px;
}

.cashReportOperation {
  padding: 10px 0;

  border-top: 1px solid rgba(0, 0, 0, 0.07);
}

.cashReportOperationMain {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;
}

.cashReportOperationDate {
  font-size: 15px;
}

.cashReportOperationMain strong {
  white-space: nowrap;
}


/* =====================================================
   COMMENT
   ===================================================== */

.cashReportOperationComment {
  margin-top: 5px;

  font-size: 14px;
  opacity: 0.7;
}


/* =====================================================
   EMPTY
   ===================================================== */

.cashReportEmpty {
  padding: 12px 0;

  font-size: 14px;
  opacity: 0.6;
}


/* =====================================================
   MOBILE
   ===================================================== */

@media (max-width: 600px) {

  .cashReportBalance {
    font-size: 16px;
  }

  .cashReportBalance strong {
    font-size: 18px;
  }

  .cashReportGroupHeader {
    padding-left: 8px;
    padding-right: 8px;
  }

  .cashReportGroupDetails {
    padding-left: 34px;
    padding-right: 8px;
  }
}

/* =====================================================
   CASH REPORT PERIOD
   ===================================================== */

.cashReportPeriod {
  display: flex;
  align-items: center;
  gap: 12px;

  margin: 18px 0 12px;
}

.cashReportDateField {
  display: flex;
  align-items: center;
  gap: 6px;

  flex: 1;
  min-width: 0;

  font-size: 14px;
  font-weight: 600;
}

.cashReportDateField .saleDate {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* Остаток на начало / конец */

.cashReportBalance {
  font-size: 21px;
}

.cashReportBalance strong {
  font-size: 23px;
}


/* Названия групп:
   Реализация, Терминал, Съём... */

.cashReportGroupHeader {
  font-size: 20px;
}

.cashReportGroupHeader strong {
  font-size: 20px;
}


/* Строки внутри раскрытого списка */

.cashReportOperationDate {
  font-size: 18px;
}

.cashReportOperationMain strong {
  font-size: 18px;
}


/* Комментарий */

.cashReportOperationComment {
  font-size: 17px;
}


/* Нет операций */

.cashReportEmpty {
  font-size: 17px;
}

/* =====================================================
   DISABLE TEXT SELECTION
   ===================================================== */

body {
  -webkit-user-select: none;
  user-select: none;

  -webkit-touch-callout: none;
}


/* =====================================================
   ALLOW SELECTION ONLY IN EDITABLE INPUTS
   ===================================================== */

input:not([type="date"]),
textarea {
  -webkit-user-select: text;
  user-select: text;

  -webkit-touch-callout: default;
}


/* =====================================================
   DATE
   ===================================================== */

input[type="date"] {
  -webkit-user-select: none;
  user-select: none;

  -webkit-touch-callout: none;
}
